# Authored on Windows, built on Linux CI. Normalise to LF in the repository so
# diffs and the Pages build see the same bytes regardless of who committed.
* text=auto eol=lf

# Hand-authored CSS. The generated token CSS is gitignored, so this rule never
# applies to it; the only file it touches today is src/app/globals.css.
*.css text eol=lf
